# Shared environment template for local development.
# Copy to backend/.env and/or repo-root .env as needed.

# Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///./bbp.db
DATA_KIT_PATH=../data_kit
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Control-loop defaults (Phases 6–9)
REPLAY_PROCESS_MINUTES_PER_WALL_SECOND=1.0
FEED_RATE_MIN=0.0
FEED_RATE_MAX=30.0
ACTUATOR_LAG_PROCESS_MINUTES=5.0
CONTROLLER_DWELL_PROCESS_MINUTES=5.0

# Production packaging (Phase 13) — enabled by render-start.sh
BOOTSTRAP_ON_STARTUP=false
SEED_CONTROL_READINGS=true
SEED_CONTROL_MINUTES=70
# STATIC_DIR=   # empty → use backend/app/static when present

# Simulator (Phase 6+)
API_BASE=http://127.0.0.1:8000
SIMULATOR_RUN_FILE=run_A.csv
